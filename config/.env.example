# Copy this file to config/.env and put your key after "=". config/.env stays on this computer
# (it is in .gitignore). Only the key for the provider chosen in settings.toml [online_ai] is used.

# Google Gemini (recommended, best Hindi). Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq (fast, free tier): https://console.groq.com/keys
GROQ_API_KEY=

# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
